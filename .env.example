# Copy this file to .env and fill in real values:
#   cp .env.example .env
# Never commit your actual .env file to GitHub -- it contains secrets.

# --- Database ---
# Must match the values in docker-compose.yml
DATABASE_URL=postgresql://pingme:pingme@localhost:5432/pingme_db

# --- Auth / JWT ---
# Any long random string works. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Telegram (only needed for scripts/test_telegram.py right now) ---
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_CHAT_ID=your-telegram-chat-id
REDIS_URL=redis://localhost:6379/0