GROQ_API_KEY=your-groq-api-key-here
MODEL_NAME=openai/gpt-oss-120b

DATABASE_URL=sqlite+aiosqlite:///./pingme.db

# Local dev default. For deployment, Upstash Redis's free tier gives a
# rediss:// URL — drop it in here directly.
REDIS_URL=redis://localhost:6379/0

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

SCHEDULER_POLL_SECONDS=5
MAX_CONSECUTIVE_FAILURES=10
ENABLE_DISCOVERY=false

# Only needed for the free-hosting path (see README) — protects the
# /tick endpoint from being triggered by anyone who finds the URL.
TICK_SECRET=
